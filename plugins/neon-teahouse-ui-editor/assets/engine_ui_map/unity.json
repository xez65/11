{
  "engine": "unity",
  "uiFilePatterns": [
    "Assets/**/*.uss",
    "Assets/**/*.uxml",
    "Assets/**/*.prefab"
  ],
  "elements": {
    "dialoguePanelRoot": {
      "file": "Assets/UI/Dialogue.uss",
      "kind": "css",
      "selector": ".DialoguePanel",
      "properties": {
        "backgroundColor": "background",
        "textColor": "color",
        "fontSizePx": "font-size",
        "xPercent": "left",
        "yPercent": "top",
        "widthPercent": "width",
        "heightPercent": "height"
      }
    }
  }
}
